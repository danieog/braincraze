# Copy this file to .env and fill in your values. Never commit .env.
# Find both in Supabase: Project Settings > API.
# EXPO_PUBLIC_ variables are bundled into the app, so only put values here that are safe to be public.
# The anon key is safe ONLY because Row Level Security is enabled on every table.
# NEVER put the service_role key, or any LLM API key (Groq/Gemini), in this file or anywhere in the app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Where the signup confirmation email sends people. Defaults to https://braincraze.study.
# Use http://localhost:8081 while testing the web app locally (and add it to Supabase Redirect URLs).
EXPO_PUBLIC_SITE_URL=https://braincraze.study

# ID check (server side only, NOT in this file): set these as Supabase function secrets, never EXPO_PUBLIC_:
#   supabase secrets set OLLAMA_URL=https://your-ollama-host OLLAMA_TOKEN=your-bearer-token
#   supabase functions deploy verify-id
